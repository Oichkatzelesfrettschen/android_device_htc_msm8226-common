# Audio
ro.af.client_heap_size_kbyte=7168
ro.audio.flinger_standbytime_ms=300

# BPF: Linux 3.4 has no bpf(2). bpfloader skips its programs and netd starts
# without its TrafficController when this reads false.
ro.kernel.ebpf.supported=false

# Bluetooth
bluetooth.enable_timeout_ms=12000

# Dalvik: 480x854 hdpi needs modest initial and retained free heaps; preserve
# the Go 128 MiB growth limit and 256 MiB large-heap ceiling for app compatibility.
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=128m
dalvik.vm.heapsize=256m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=4m

# One compiler worker bounds concurrent compiler allocations and leaves CPU
# time for the UI on Cortex-A7. Keep boot verification cheap and compile only
# profiled install methods; first boot quickens APKs that lack preopt output.
dalvik.vm.dex2oat-threads=1
dalvik.vm.boot-dex2oat-threads=1
dalvik.vm.restore-dex2oat-threads=1
pm.dexopt.first-boot=quicken
pm.dexopt.install=speed-profile

# 1 GiB product: low_ram selects the Go-class memory behavior in the framework
# and in lmkd.
ro.config.low_ram=true

# Linux 3.4 kills through the in-kernel LMK, which lmkd selects because
# /sys/module/lowmemorykiller/parameters/minfree is writable. Nothing reads
# per-app memcg soft limits in that mode, so app processes stay in the root
# memcg instead of one 3.4 memcg each.
ro.config.per_app_memcg=false

# Display
debug.sf.latch_unsignaled=1
# SkiaGL RenderEngine aborts in SurfaceFlinger on the Adreno 305 GLES
# driver ("Unable to generate SkImage"); the GLES RenderEngine composites.
debug.renderengine.backend=gles
debug.composition.type=c2d
# The Adreno 305 driver loses the undamaged pixels of one GMEM bin when HWUI
# redraws only the damaged region of an aged buffer, so a scrolling view
# shows that bin as static. HWUI redraws the whole surface every frame.
debug.hwui.use_buffer_age=false
debug.hwui.use_partial_updates=false
debug.disable.bwc=1

# fastbootd
ro.fastbootd.available=true

# GL
ro.opengles.version=196608

