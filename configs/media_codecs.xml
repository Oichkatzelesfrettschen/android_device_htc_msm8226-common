<!--
8226 Encoder capabilities
 ______________________________________________________
 | Codec    | W       H       fps     Mbps    MB/s    |
 |__________|_________________________________________|
 | h264     | 1920    1088    30      20      244800  |
 | mpeg4    | 1920    1088    30      20      244800  |
 | vp8      | 1920    1088    30      20      244800  |
 | h263     | 864     480     30      2       48600   |
 |__________|_________________________________________|

 8226 Decoder capabilities
 ______________________________________________________
 | Codec    | W       H       fps     Mbps    MB/s    |
 |__________|_________________________________________|
 | h264     | 1920    1088    30      20      244800  |
 | hevc     | 1280    720     30      2       108000  |
 | mpeg4    | 1920    1088    30      20      244800  |
 | vp8      | 1920    1088    30      20      244800  |
 | h263     | 864     480     30      2       48600   |
 | mpeg2    | 1920    1088    30      20      244800  |
 |__________|_________________________________________|

-->
<MediaCodecs>
    <Include href="media_codecs_google_audio.xml" />
    <Include href="media_codecs_google_telephony.xml" />
    <Settings>
        <Setting name="max-video-encoder-input-buffers" value="9" />
    </Settings>
    <Encoders>
        <!-- Audio Hardware: AAC, AMR-NB, EVRC and QCELP-13 encode on the aDSP
             through /dev/msm_aac_in, /dev/msm_amrnb_in, /dev/msm_evrc_in and
             /dev/msm_qcelp_in. MediaCodecList sorts ascending by rank and the
             Codec2 software audio encoders rank 8, so the AAC and AMR-NB rows
             set rank 4 to sort ahead of them; the EVRC and QCELP-13 rows have
             no Codec2 counterpart and keep the OMX default.
             Every audio/evrc and audio/qcelp row carries a channel-count
             limit: libmedia AudioCapabilities has no platform limits for
             these types, so without max-channel-count its input-channel
             range intersects to empty and getMaxInputChannelCount() traps on
             the integer-overflow sanitizer in every MediaCodecList build. -->
        <!-- aenc-aac: one or two channels, the ADTS sampling-frequency index
             table of omx_aac_aenc.h, and the MIN_BITRATE..MAX_BITRATE clamp
             of get_updated_bit_rate. -->
        <MediaCodec name="OMX.qcom.audio.encoder.aac" type="audio/mp4a-latm" rank="4" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="channel-count" max="2" />
            <Limit name="sample-rate" ranges="8000,11025,12000,16000,22050,24000,32000,44100,48000" />
            <Limit name="bitrate" range="24000-192000" />
        </MediaCodec>
        <!-- aenc-amrnb: mono 8 kHz, the eight narrowband modes 4750-12200. -->
        <MediaCodec name="OMX.qcom.audio.encoder.amrnb" type="audio/3gpp" rank="4" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="channel-count" max="1" />
            <Limit name="sample-rate" ranges="8000" />
            <Limit name="bitrate" range="4750-12200" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.encoder.evrc" type="audio/evrc" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="channel-count" max="1" />
            <Limit name="sample-rate" ranges="8000" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.encoder.qcelp13" type="audio/qcelp" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Limit name="channel-count" max="1" />
            <Limit name="sample-rate" ranges="8000" />
        </MediaCodec>
        <!-- Video Hardware  -->
        <MediaCodec name="OMX.qcom.video.encoder.avc" type="video/avc" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-loaded-to-idle-after-allocation" />
            <Quirk name="video-controller-check-enable" />            
            <Limit name="size" min="96x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.encoder.mpeg4" type="video/mp4v-es" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-loaded-to-idle-after-allocation"/>
            <Quirk name="video-controller-check-enable" /> 
            <Limit name="size" min="96x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.encoder.h263" type="video/3gpp" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-loaded-to-idle-after-allocation" />
            <Quirk name="video-controller-check-enable" /> 
            <Limit name="size" min="96x64" max="864x480" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="48600" />
            <Limit name="bitrate" range="1-2000000" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <!-- Venus VP8 encode: msm_venc.c lists V4L2_PIX_FMT_VP8 in
             venc_formats[], the Venus firmware carries the VP8e session
             handlers, and omx_video_encoder.cpp creates the vp8 kind under
             _MSM8974_. The size and rate limits are the avc and mpeg4 encoder
             limits: 1920x1088 at 30 fps is 244800 macroblocks per second,
             inside the 352800 qcom,max-hw-load of the msm-vidc node. -->
        <MediaCodec name="OMX.qcom.video.encoder.vp8" type="video/x-vnd.on2.vp8" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-loaded-to-idle-after-allocation" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="96x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
    </Encoders>
    <Decoders>
        <!-- Audio Software: QCELP-13 and EVRC vocoders in libOmxQcelp13Dec and
             libOmxEvrcDec, installed by the vendor tree. -->
        <MediaCodec name="OMX.qcom.audio.decoder.Qcelp13" type="audio/qcelp" >
            <Quirk name="requires-global-flush" />
            <Limit name="channel-count" max="1" />
            <Limit name="sample-rate" ranges="8000" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.decoder.evrc" type="audio/evrc" >
            <Quirk name="requires-global-flush" />
            <Limit name="channel-count" max="1" />
            <Limit name="sample-rate" ranges="8000" />
        </MediaCodec>
        <!-- Audio Hardware: aDSP decoders behind /dev/msm_wma, /dev/msm_wmapro
             and /dev/msm_amrwbplus in libOmxWmaDec and libOmxAmrwbplusDec,
             installed by the vendor tree. The qdsp6v2 AIO drivers accept one
             or two channels at up to 48 kHz. -->
        <MediaCodec name="OMX.qcom.audio.decoder.wma" type="audio/x-ms-wma" >
            <Quirk name="requires-global-flush" />
            <Limit name="channel-count" max="2" />
            <Limit name="sample-rate" ranges="8000-48000" />
            <Limit name="bitrate" range="1-768000" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.decoder.wma10Pro" type="audio/x-ms-wma-pro" >
            <Quirk name="requires-global-flush" />
            <Limit name="channel-count" max="2" />
            <Limit name="sample-rate" ranges="8000-48000" />
            <Limit name="bitrate" range="1-768000" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.decoder.wmaLossLess" type="audio/x-ms-wma-lossless" >
            <Quirk name="requires-global-flush" />
            <Limit name="channel-count" max="2" />
            <Limit name="sample-rate" ranges="8000-48000" />
            <Limit name="bitrate" range="1-1600000" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.decoder.amrwbplus" type="audio/amr-wb-plus" >
            <Limit name="channel-count" max="2" />
            <Limit name="sample-rate" ranges="8000-48000" />
            <Limit name="bitrate" range="5200-48000" />
        </MediaCodec>
        <!-- libOmxAacDec decodes AAC-LC, HE-AAC and HE-AAC v2 on the aDSP:
             OMX.qcom.audio.decoder.aac through /dev/msm_aac (audio_aac.c,
             mono and stereo) and OMX.qcom.audio.decoder.multiaac through
             /dev/msm_multi_aac (audio_multi_aac.c, the 5.1 decoder). Both
             register the audio_decoder.aac role. MediaCodecList sorts
             ascending by rank and c2.android.aac.decoder ranks 8, so the
             rows set 4 and 5 to sort ahead of it; the stereo component comes
             first and the 5.1 component second. -->
        <MediaCodec name="OMX.qcom.audio.decoder.aac" type="audio/mp4a-latm" rank="4" >
            <Limit name="channel-count" max="2" />
            <Limit name="sample-rate" ranges="8000,11025,12000,16000,22050,24000,32000,44100,48000" />
            <Limit name="bitrate" range="8000-576000" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.audio.decoder.multiaac" type="audio/mp4a-latm" rank="5" >
            <Limit name="channel-count" max="6" />
            <Limit name="sample-rate" ranges="8000,11025,12000,16000,22050,24000,32000,44100,48000" />
            <Limit name="bitrate" range="8000-960000" />
        </MediaCodec>
        <!-- Video Hardware  -->
        <MediaCodec name="OMX.qcom.video.decoder.avc" type="video/avc" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Feature name="adaptive-playback" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.decoder.mpeg2" type="video/mpeg2" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="96x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Feature name="adaptive-playback" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.decoder.mpeg4" type="video/mp4v-es" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Feature name="adaptive-playback" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.decoder.h263" type="video/3gpp" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="64x64" max="864x480" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="48600" />
            <Limit name="bitrate" range="1-2000000" />
            <Feature name="adaptive-playback" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <!-- HEVC Main profile on the q6 HFI core (/dev/video34). The core's
             qcom,max-hw-load of 108000 macroblocks per second bounds a session
             to 1280x720 at 30 fps, and one such session fills it. libOmxVdec
             serves the kind when the HAL build defines OMX_VDEC_HEVC_Q6.
             MediaCodecList sorts OMX video decoders (rank 256) ahead of the
             Codec2 software decoder (512), and findMatchingCodecs drops this
             row for formats outside the size range, so larger clips reach
             c2.android.hevc.decoder. -->
        <MediaCodec name="OMX.qcom.video.decoder.hevc" type="video/hevc" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="64x64" max="1280x720" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="108000" />
            <Limit name="bitrate" range="1-2000000" />
            <Feature name="adaptive-playback" />
            <Limit name="concurrent-instances" max="1" />
        </MediaCodec>
        <!-- SMPTE 421M: WMV3 simple and main profile (video/x-ms-wmv, STRUCT_C
             codec data) and WVC1 advanced profile (video/wvc1, start-code
             sequence header) both decode in the Venus VC-1 session. -->
        <MediaCodec name="OMX.qcom.video.decoder.vc1" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <!-- Limits outside a Type are ignored for a multi-type codec. -->
            <Type name="video/x-ms-wmv" >
                <Limit name="size" min="64x64" max="1920x1088" />
                <Limit name="alignment" value="2x2" />
                <Limit name="block-size" value="16x16" />
                <Limit name="blocks-per-second" min="1" max="244800" />
                <Limit name="bitrate" range="1-20000000" />
                <Limit name="concurrent-instances" max="13" />
            </Type>
            <Type name="video/wvc1" >
                <Limit name="size" min="64x64" max="1920x1088" />
                <Limit name="alignment" value="2x2" />
                <Limit name="block-size" value="16x16" />
                <Limit name="blocks-per-second" min="1" max="244800" />
                <Limit name="bitrate" range="1-20000000" />
                <Limit name="concurrent-instances" max="13" />
            </Type>
        </MediaCodec>
        <MediaCodec name="OMX.qcom.video.decoder.vp8" type="video/x-vnd.on2.vp8" >
            <Quirk name="requires-allocate-on-input-ports" />
            <Quirk name="requires-allocate-on-output-ports" />
            <Quirk name="requires-timestamp-reorder" />
            <Quirk name="video-controller-check-enable" />
            <Limit name="size" min="64x64" max="1920x1088" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" min="1" max="244800" />
            <Limit name="bitrate" range="1-20000000" />
            <Feature name="adaptive-playback" />
            <Limit name="concurrent-instances" max="13" />
        </MediaCodec>
        <MediaCodec name="OMX.google.opus.decoder" type="audio/opus" update="true" rank="100"/>
    </Decoders>
    <Include href="media_codecs_google_video_le.xml" />
</MediaCodecs>
