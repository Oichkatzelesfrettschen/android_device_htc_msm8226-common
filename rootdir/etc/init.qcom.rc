# HTC a11chl mounts the firmware partitions before vendor services use them.
on fs
    mount_all /vendor/etc/fstab.qcom --early
    swapon_all /vendor/etc/fstab.qcom

on late-fs
    mount_all /vendor/etc/fstab.qcom --late

# The Wi-Fi HAL runs as wifi and starts the built-in WLAN driver by writing
# its firmware mode to fwpath.
on boot
    chown wifi wifi /sys/module/wlan/parameters/fwpath
    # The aDSP carries the LPASS audio path: the msm8226 ASoC machine driver
    # defers its probe until the aDSP is up, so no sound card exists until
    # adsp-loader boots it.
    write /sys/kernel/boot_adsp/boot 1

# wpa_supplicant copies its template configuration into /data/vendor/wifi/wpa
# and opens its control sockets under wpa/sockets; it creates neither directory.
on post-fs-data
    # Recovery-created cache markers must use the platform cache label.
    restorecon /cache/.version
    # Label the QMUX directory before QCRIL binds its client sockets.
    mkdir /dev/socket/qmux_radio 0770 radio radio
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on property:sys.boot_completed=1
    # Recovery-created media markers must use the platform media label.
    restorecon /data/media/0/TWRP/.twrps

# HTC's radio daemons use the modem calibration partitions and QMI sockets.
# They start only when persist.vendor.radio.start is 1: qmuxd opens the SMD
# port that boots the modem, and HTC qmuxd requests reboot,oem-98 once the
# modem stays unreachable, so the modem boots only with its EFS server ready.
on property:persist.vendor.radio.start=1
    start rmt_storage
    start qmuxd
    start netmgrd

service rmt_storage /vendor/bin/rmt_storage modem_st1 modem_st2 fsc recovery radio_config cdma_record
    class core
    disabled
    user root
    group system wakelock
    shutdown critical
    ioprio rt 0
    setenv LD_PRELOAD /vendor/lib/liba11-legacy-radio.so

service qmuxd /vendor/bin/qmuxd
    class core
    disabled
    user radio
    group radio audio bluetooth gps diag log
    setenv LD_PRELOAD /vendor/lib/liba11-legacy-radio.so

service netmgrd /vendor/bin/netmgrd
    class core
    disabled
    user root
    group radio inet net_admin net_raw
    setenv LD_PRELOAD /vendor/lib/liba11-legacy-radio.so

service wcnss-service /system/bin/wcnss_service
    class late_start
    user system
    group system wifi radio diag
    oneshot

# The HAL and daemon exchange V4L2 events and per-camera Unix sockets.
service qcamerasvr /vendor/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera system inet input graphics
    setenv LD_PRELOAD /vendor/lib/liba11-legacy-radio.so

# libbt-vendor sets bluetooth.hciattach=true on each enable and waits for
# bluetooth.status=on before it opens the SMD transport. hci_qcomm_init imports
# HTC liblog's __htclog_init_mask, so the service preloads the shim.
service hciattach /vendor/bin/sh /vendor/bin/init.qcom.bt.sh
    class late_start
    user bluetooth
    group bluetooth net_bt_admin system
    setenv LD_PRELOAD /vendor/lib/liba11-legacy-radio.so
    disabled
    oneshot
    seclabel u:r:htc_bluetooth_loader:s0

on property:bluetooth.hciattach=true
    start hciattach

on property:bluetooth.hciattach=false
    setprop bluetooth.status off

# The HTC acdb loader set that the audio HAL dlopens references HTC liblog's
# __htclog_init_mask; liba11-legacy-radio.so provides that ABI, so the audio
# HAL preloads it as the radio daemons do.
service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    override
    class hal
    user audioserver
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct wakelock context_hub
    capabilities BLOCK_SUSPEND
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart audioserver
    setenv LD_PRELOAD /vendor/lib/liba11-legacy-radio.so
