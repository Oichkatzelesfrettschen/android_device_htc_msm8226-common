allow init firmware_file:dir mounton;
allow init htc_sysfs_sensors:file setattr;
allow init htc_sysfs_adsp:file w_file_perms;
allow init { htc_sysfs_cpu_boost htc_sysfs_ksm }:file w_file_perms;
allow init htc_proc_last_kmsg:file setattr;
# init.qcom.rc follows the android0 USB gadget link while it configures USB.
allow init sysfs_android_usb:lnk_file read;

# swapon_all in init.qcom.rc writes the swap header to the zram device.
allow init ram_device:blk_file rw_file_perms;


# init.a11chl.rc enables sweep2wake and doubletap2wake from /sys/android_touch
# once boot completes.
allow init htc_sysfs_touch_wake:file w_file_perms;
