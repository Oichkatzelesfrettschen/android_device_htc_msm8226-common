# The legacy daemon receives kernel camera events and serves the HAL's sockets.
type a11_camera_daemon, domain;
type a11_camera_daemon_exec, exec_type, vendor_file_type, file_type;
type a11_camera_socket, file_type, data_file_type;
init_daemon_domain(a11_camera_daemon)

allow a11_camera_daemon device:dir r_dir_perms;
allow a11_camera_daemon { camera_device video_device ion_device }:chr_file rw_file_perms;
allow a11_camera_daemon vendor_data_file:dir search;
allow a11_camera_daemon a11_camera_socket:dir rw_dir_perms;
allow a11_camera_daemon a11_camera_socket:sock_file create_file_perms;
allow a11_camera_daemon self:unix_stream_socket create_stream_socket_perms;
allow a11_camera_daemon self:unix_dgram_socket create_socket_perms;
allow hal_camera_default vendor_data_file:dir search;
allow hal_camera_default a11_camera_socket:dir search;
allow hal_camera_default a11_camera_socket:sock_file rw_file_perms;
allow hal_camera_default a11_camera_daemon:unix_stream_socket connectto;
allow hal_camera_default a11_camera_daemon:unix_dgram_socket sendto;

# The daemon publishes sensor fuse identifiers and the 4K capability flag.
vendor_public_prop(a11_camera_prop)
# Names read inside app processes: the legacy camera2 shim's
# persist.camera.legacy_perf and the camera app's privapp list.
vendor_public_prop(a11_camera_app_prop)
get_prop(appdomain, a11_camera_app_prop)
set_prop(a11_camera_daemon, a11_camera_prop)

# Preview buffers arrive as dmabuf descriptors from the HAL in the camera
# provider.
allow a11_camera_daemon hal_camera_default:fd use;

# The HAL1 blob writes persist.camera.forceuseaudio. property_contexts puts
# the persist.camera. family in a11_camera_prop, which only the daemon sets,
# so the write fails without effect on capture.
dontaudit hal_camera_default property_socket:sock_file write;
dontaudit hal_camera_default init:unix_stream_socket connectto;

# C2D colour conversion and the image post-processing modules run on Adreno.
allow a11_camera_daemon gpu_device:chr_file rw_file_perms;
# Preview and capture buffers come from gralloc.
allow a11_camera_daemon hal_graphics_allocator:fd use;
# The HAL logs the kernel version when it opens a camera.
allow hal_camera_default proc_version:file r_file_perms;
# libmmcamera_imglib.so keeps the face recognition album at /data/vendor/fa,
# a link to /data/vendor/c/fdAlbum.
type a11_camera_album_file, file_type, data_file_type;
allow a11_camera_daemon vendor_data_file:lnk_file read;
allow a11_camera_daemon a11_camera_album_file:file create_file_perms;
type_transition a11_camera_daemon a11_camera_socket:file a11_camera_album_file "fdAlbum";
# libawb_calibration.so reads the per-unit AWB calibration, and the stats
# algorithm reads the flashlight's current limit and dual-LED capability.
r_dir_file(a11_camera_daemon, htc_sysfs_camera)
r_dir_file(a11_camera_daemon, sysfs_leds)

# The imaging libraries read their tuning and debug switches.
get_prop(a11_camera_daemon, a11_camera_prop)
