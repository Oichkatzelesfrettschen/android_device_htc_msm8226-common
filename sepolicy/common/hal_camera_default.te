# The HAL reads HTC white-balance calibration and sensor identity from
# /sys/android_camera*, the daemon's published sensor properties, and the
# SurfaceFlinger configstore; a failed calibration open aborts the provider.
r_dir_file(hal_camera_default, htc_sysfs_camera)
get_prop(hal_camera_default, a11_camera_prop)
hal_client_domain(hal_camera_default, hal_configstore)

# The camera provider libraries probe ro.vendor.camera.* settings the product
# leaves unset, and an unset property reads as its default either way.
dontaudit hal_camera_default vendor_default_prop:file { getattr map open read };

# The HAL also probes persist.debug.sf.showfps, persist.debug.set.fixedfps
# and persist.debug.camera.qctfd (persist_debug_prop) and the
# gsm.*operator.numeric names (radio_prop). Both are core-private property
# types that system/sepolicy/private/property.te forbids every vendor
# domain to read, so the debug switches stay at their defaults and the
# operator lookup returns empty.
dontaudit hal_camera_default { persist_debug_prop radio_prop }:file { getattr map open read };

# QCameraGrallocMemory maps preview buffers through GraphicBufferMapper, whose
# passthrough IMapper lookup goes through hwservicemanager; without the
# mapper the HAL aborts in startPreview with "gralloc-mapper is missing".
allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
vndbinder_use(hal_camera_default)
