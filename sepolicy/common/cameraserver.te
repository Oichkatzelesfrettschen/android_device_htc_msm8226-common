# The HTC HAL1 camera blob, loaded into cameraserver, reads motion data
# through SensorManager.
allow cameraserver sensorservice_service:service_manager find;
binder_call(cameraserver, system_server)

# The HAL reads HTC white-balance calibration and sensor identity from
# /sys/android_camera*, the daemon's published sensor properties, and the
# SurfaceFlinger configstore; a failed calibration open aborts cameraserver.
r_dir_file(cameraserver, htc_sysfs_camera)
get_prop(cameraserver, a11_camera_prop)
hal_client_domain(cameraserver, hal_configstore)

# The camera provider libraries probe ro.vendor.camera.* settings the product
# leaves unset, and an unset property reads as its default either way.
dontaudit cameraserver vendor_default_prop:file { getattr map open read };
