type netmgrd, domain;
type netmgrd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(netmgrd)
net_domain(netmgrd)

# netmgrd configures the rmnet data links through the device-private
# ioctl range (SIOCDEVPRIVATE..SIOCDEVPRIVATE+15) and interface state.
allow netmgrd self:capability net_admin;
allow netmgrd self:netlink_socket create_socket_perms_no_ioctl;
allow netmgrd self:udp_socket ioctl;
allowxperm netmgrd self:udp_socket ioctl { 0x89f0-0x89ff };

# init starts netmgrd as root; libdsutils' ds_change_user_cap keeps the
# capability set across setgid and setuid to radio, and netmgrd aborts when
# that change fails.
allow netmgrd self:capability { setgid setuid };

# The kernel interface module opens NETLINK_XFRM to install and flush the
# IPsec SAs and policies the modem negotiates for a data call.
allow netmgrd self:netlink_xfrm_socket { create_socket_perms_no_ioctl nlmsg_read nlmsg_write };

# Its module probes and /system/bin/sh helper scripts stay denied: the kernel
# builds rmnet in, and vendor domains run no system binaries.
dontaudit netmgrd self:capability { sys_module sys_resource };
dontaudit netmgrd shell_exec:file execute;

# Its helper shell writes accept_ra for each rmnet link and looks up tc and
# iptables on PATH. netd's InterfaceController::initializeAll() already sets
# accept_ra to 2 on default and every existing interface, and vendor domains
# may not execute system binaries, so both stay denied.
dontaudit netmgrd proc_net:file write;
dontaudit netmgrd system_file:file getattr;

# netmgrd reads its QoS, iWLAN and log configuration and the baseband type.
get_prop(netmgrd, a11_radio_config_prop)
