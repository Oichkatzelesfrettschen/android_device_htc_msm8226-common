type netmgrd, domain;
type netmgrd_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(netmgrd)
net_domain(netmgrd)

# netmgrd configures the rmnet data links through the device-private
# ioctl range (SIOCDEVPRIVATE..SIOCDEVPRIVATE+15) and interface state.
allow netmgrd self:capability net_admin;
allow netmgrd self:netlink_socket create_socket_perms_no_ioctl;
allow netmgrd self:udp_socket ioctl;
allowxperm netmgrd self:udp_socket ioctl { 0x89f0-0x89ff };

# Its module probes and /system/bin/sh helper scripts stay denied: the kernel
# builds rmnet in, and vendor domains run no system binaries.
dontaudit netmgrd self:capability { sys_module sys_resource };
dontaudit netmgrd shell_exec:file execute;
