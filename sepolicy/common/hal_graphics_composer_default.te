# The legacy composer receives display hotplug events from the kernel.
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket read;

# The legacy composer uses Binder for display callbacks and vendor services.
binder_use(hal_graphics_composer_default)
hwbinder_use(hal_graphics_composer_default)
vndbinder_use(hal_graphics_composer_default)
hal_client_domain(surfaceflinger, hal_graphics_composer)
binder_call(hal_graphics_composer, surfaceflinger)
allow hal_graphics_composer surfaceflinger_service:service_manager find;
r_dir_file(hal_graphics_composer, htc_sysfs_graphics)
