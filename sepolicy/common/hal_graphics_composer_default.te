# The legacy composer receives display hotplug events from the kernel.
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;

# The legacy composer uses Binder for display callbacks and vendor services.
binder_use(hal_graphics_composer_default)
hwbinder_use(hal_graphics_composer_default)
vndbinder_use(hal_graphics_composer_default)
hal_client_domain(surfaceflinger, hal_graphics_composer)
binder_call(hal_graphics_composer, surfaceflinger)
allow hal_graphics_composer surfaceflinger_service:service_manager find;
r_dir_file(hal_graphics_composer, htc_sysfs_graphics)
# The composer polls vsync_event and writes idle_time and dynamic_fps.
allow hal_graphics_composer htc_sysfs_graphics:file w_file_perms;

# The composer publishes display.qservice on vndbinder and looks it up again.
allow hal_graphics_composer_default qdisplay_service:service_manager { add find };

# The composer reads its MDP composition, HDMI and action-safe settings.
get_prop(hal_graphics_composer_default, a11_display_config_prop)
