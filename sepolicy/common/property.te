# Android 12 labels a property with no property_contexts entry default_prop,
# which only core domains read. The vendor blobs read these families, and
# init loads the ones the product sets from vendor/build.prop.
vendor_internal_prop(a11_radio_config_prop)
vendor_internal_prop(a11_display_config_prop)
vendor_internal_prop(a11_media_config_prop)
vendor_internal_prop(a11_wlan_config_prop)
vendor_internal_prop(htc_bluetooth_config_prop)
vendor_internal_prop(htc_bluetooth_hciattach_prop)
