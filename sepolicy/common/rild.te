# QCRIL rebuilds qcril.db and its SQLite journals in /dev/radio each boot.
allow rild a11_qcril_device:dir rw_dir_perms;
allow rild a11_qcril_device:file { create_file_perms ioctl };
# SQLite probes F2FS_IOC_GET_FEATURES on the database file.
allowxperm rild a11_qcril_device:file ioctl 0xf50c;

# QMUX clients bind dynamically named sockets inside the radio socket directory.
allow rild htc_qmux_radio_socket:dir rw_dir_perms;
allow rild htc_qmux_radio_socket:sock_file { create setattr getattr read write unlink };
type_transition rild htc_qmux_radio_socket:sock_file htc_qmux_radio_socket;

# QCRIL reads its data-call, LTE band and PDN configuration.
get_prop(rild, a11_radio_config_prop)
