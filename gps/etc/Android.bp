// The legacy location blobs open their configuration under /system/etc, and
// the files themselves install to /vendor/etc. These links live in the
// device/htc/msm8226-common namespace, so only a product that lists the
// namespace exports their install rules.

install_symlink {
    name: "msm8226_gnss_config_link_flp_conf",
    installed_location: "etc/flp.conf",
    symlink_target: "/vendor/etc/flp.conf",
}

install_symlink {
    name: "msm8226_gnss_config_link_gps_conf",
    installed_location: "etc/gps.conf",
    symlink_target: "/vendor/etc/gps.conf",
}

install_symlink {
    name: "msm8226_gnss_config_link_izat_conf",
    installed_location: "etc/izat.conf",
    symlink_target: "/vendor/etc/izat.conf",
}

install_symlink {
    name: "msm8226_gnss_config_link_sap_conf",
    installed_location: "etc/sap.conf",
    symlink_target: "/vendor/etc/sap.conf",
}
